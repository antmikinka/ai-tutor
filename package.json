{
  "name": "ai-math-tutor-desktop",
  "version": "1.0.0",
  "description": "Desktop AI math tutor: Electron + React renderer, Python FastAPI backend with a SymPy engine and optional local models",
  "main": "src/main/main.js",
  "homepage": "./",
  "private": true,
  "scripts": {
    "postinstall": "cd src/renderer && npm install",
    "start": "electron .",
    "dev": "concurrently -k -n react,electron -c cyan,magenta \"npm run dev:react\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:react": "cd src/renderer && cross-env BROWSER=none REACT_APP_BACKEND_URL=http://127.0.0.1:8000 npm start",
    "dev:backend": "cd src/backend && python main.py",
    "build:react": "cd src/renderer && npm run build",
    "build": "npm run build:react && electron-builder --windows",
    "pack": "npm run build:react && electron-builder --dir",
    "dist": "npm run build",
    "typecheck": "cd src/renderer && npx tsc --noEmit -p .",
    "lint": "cd src/renderer && npm run lint",
    "test": "npm run test:backend && npm run test:renderer",
    "test:backend": "cd src/backend && python -m pytest -q",
    "test:renderer": "cd src/renderer && cross-env CI=true npm test -- --watchAll=false --passWithNoTests",
    "install:python-deps": "cd src/backend && pip install -r requirements.txt -r requirements-dev.txt",
    "install:python-ml": "cd src/backend && pip install -r requirements-ml.txt",
    "setup:models": "python scripts/setup_models.py"
  },
  "keywords": [
    "electron",
    "react",
    "fastapi",
    "sympy",
    "math-tutor",
    "fabricjs",
    "qwen"
  ],
  "author": "AI Math Tutor Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-log": "^4.4.8",
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.aimathtutor.desktop",
    "productName": "AI Math Tutor",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/.pytest_cache/**",
          "!tests/**",
          "!data/**",
          "!logs/**",
          "!models/**",
          "!temp/**",
          "!uploads/**",
          "!.env"
        ]
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "*.py",
          "*.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Math Tutor",
      "include": "assets/installer.nsh"
    },
    "portable": {
      "artifactName": "AI-Math-Tutor-Portable.exe"
    }
  }
}
